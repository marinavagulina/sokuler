---
/**
 * Футер: контакты, соцсети (из config.ts, target=_blank), копирайт.
 */
import { SITE } from '../config';
const year = new Date().getFullYear();
---
<footer>
  <div class="inner">
    <div class="col">
      <p class="name">{SITE.name}</p>
      <p class="muted">{SITE.role}</p>
    </div>
    <div class="col">
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      <div class="socials">
        <a href={SITE.socials.vk.url} target="_blank" rel="noopener noreferrer">ВКонтакте</a>
        <a href={SITE.socials.telegram.url} target="_blank" rel="noopener noreferrer">Telegram</a>
        <a href={SITE.socials.youtube.url} target="_blank" rel="noopener noreferrer">YouTube</a>
      </div>
    </div>
    <div class="col">
      <p class="muted">© {year} {SITE.name}</p>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
    padding: var(--sp-7) var(--pad-x) var(--sp-7);
    margin-top: var(--sp-9);
    font-size: 13px;
  }
  .inner {
    max-width: 1160px; margin-inline: auto;
    display: flex; flex-wrap: wrap; gap: var(--sp-6) var(--sp-8);
    justify-content: space-between;
  }
  .name { font-family: var(--font-display); font-weight: 600; font-size: 16px; }
  .muted { color: var(--text-muted); }
  footer a { color: var(--bronze); text-decoration: none; }
  footer a:hover { text-decoration: underline; }
  .socials { display: flex; gap: var(--sp-4); margin-top: var(--sp-2); }
</style>
