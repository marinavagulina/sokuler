---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';

// schema.org JSON-LD: Service — обучение бас-гитаре и контрабасу.
// Цену НЕ публикуем (нет согласия владельца), поэтому offers не указываем.
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Индивидуальные занятия бас-гитарой и контрабасом',
  serviceType: 'Уроки бас-гитары и контрабаса',
  url: `${SITE.url}/obuchenie/`,
  description: 'Индивидуальные уроки бас-гитары и контрабаса в Москве, у м. Сокольники: педагог с 2004 года, стили рок, поп, фанк, джаз, подготовка в музыкальные училища и вузы.',
  provider: {
    '@type': 'Person',
    name: 'Сергей Сокулер',
    jobTitle: 'Бас-гитарист, контрабасист, педагог',
    url: `${SITE.url}/`,
  },
  areaServed: { '@type': 'City', name: 'Москва' },
};
---
<Base title="Уроки бас-гитары и контрабаса в Москве — Сергей Сокулер" theme="light"
      description="Уроки бас-гитары и контрабаса в Москве у м. Сокольники: педагог с 2004 года, рок, поп, фанк, джаз, подготовка в училища и вузы. Запишитесь на занятие!">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceLd)} />
  <article class="teach">
    <p class="overline">Ученикам</p>
    <h1>Занятия бас-гитарой <span class="amp script">и</span> контрабасом</h1>
    <p class="lead">
      Приглашаю на занятия как начинающих басистов, так и тех, кто хочет
      улучшить свой уровень. За более чем 20-летний педагогический стаж
      я сформировал свою методику, которая продолжает совершенствоваться.
    </p>

    <nav class="toc" aria-label="Разделы страницы">
      <a href="#kak">Как проходит работа</a>
      <a href="#rezultat">Что вы получите</a>
      <a href="#napravleniya">Направления</a>
      <a href="#organizaciya">Организация</a>
      <a href="#otzyvy">Отзывы</a>
    </nav>

    <section id="kak" class="block">
      <h2>Как проходит работа</h2>
      <div class="kak-grid">
        <div class="kak-text">
          <p><b>Формат.</b> Индивидуальные занятия 45–50 минут в классе в 5 минутах
          от метро «Сокольники» — с инструментами и аппаратурой на месте. По
          договорённости — у вас дома или по видеосвязи (начинающим — только очно:
          постановку рук по видео нормально не отследишь).</p>
          <p><b>Стилистика.</b> Рок, поп, фанк, джаз, латино-американская музыка.
          От качественного звукоизвлечения и грува — до чтения с листа, импровизации
          и собственных басовых партий.</p>
          <p><b>Между занятиями.</b> Всегда есть возможность обратной связи по
          телефону или видео — например, если появились вопросы по «домашке».
          Помогу подобрать инструмент и отстроить его.</p>
        </div>
        <figure class="photo-card">
          <img src="/img/foto-obuchenie.jpg" alt="Сергей Сокулер за бас-гитарой на занятии" width="1500" height="1194" />
        </figure>
      </div>
    </section>

    <section id="rezultat" class="block">
      <h2>Что вы получите</h2>
      <ul class="get">
        <li>качественное звукоизвлечение — то, что сразу отличает профи от новичка;</li>
        <li>ритмичность: танцевальное ощущение музыки, то, что мы называем словом «грув»;</li>
        <li>навыки стрессоустойчивости — уверенность во время игры;</li>
        <li>видение грифа и чтение нот с листа;</li>
        <li>разные приёмы звукоизвлечения и их применение в разных жанрах;</li>
        <li>развитие слуха, умение снимать музыку на слух;</li>
        <li>основу музыкальной теории и сольфеджио;</li>
        <li>импровизацию и построение собственных басовых партий.</li>
      </ul>
    </section>

    <section id="napravleniya" class="block">
      <h2>Направления</h2>
      <div class="grid3">
        <section class="card">
          <h3>Контрабас</h3>
          <p>
            В первую очередь — пиццикато (игра пальцами правой руки), характерный
            для джаза и эстрады. Освоим «шагающий» бас, основы ведения смычка,
            простые «классические» произведения.
          </p>
        </section>
        <section class="card">
          <h3>Опыт сцены и студии</h3>
          <p>
            Поделюсь «фишками» концертной и студийной работы — это помогает
            не совершать многих ошибок и расти быстрее.
          </p>
        </section>
        <section class="card">
          <h3>Поступление</h3>
          <p>
            Есть опыт подготовки к поступлению в музыкальное училище или ВУЗ
            на эстрадно-джазовое отделение.
          </p>
        </section>
      </div>
    </section>

    <section id="organizaciya" class="block">
      <h2>Организация</h2>
      <ul class="org">
        <li>занятия индивидуальные, 45–50 минут;</li>
        <li>класс в 5 минутах ходьбы от метро «Сокольники» — инструменты и аппаратура на месте;</li>
        <li>по договорённости — выезд на дом или видеосвязь (начинающим — только очно: постановку рук по видео нормально не отследишь);</li>
        <li>между занятиями — обратная связь по телефону или видео, если есть вопросы по «домашке»;</li>
        <li>консультирую по выбору инструмента и аксессуаров, помогу отстроить.</li>
      </ul>
    </section>

    <section id="otzyvy" class="block">
      <h2>Отзывы учеников</h2>
      <div class="reviews">
        <figure class="review">
          <blockquote>
            <p>Я очень доволен. Все объясняется понятно. Показывается предельно ясно.
            Ошибки указываются корректно. Сергей — практикующий профессиональный
            музыкант, поэтому обучение идёт в разрезе того, что нужно басисту
            в 21 веке. Сергей задаёт много, и пока ты не отработаешь сам как надо,
            тебя будет мучать тем, что есть. В общем и целом — рекомендую.</p>
          </blockquote>
          <figcaption><b>Александр</b> · бас-гитара · февраль 2024</figcaption>
        </figure>
        <figure class="review">
          <blockquote>
            <p>Очень приятные впечатления о преподавателе. С первого занятия
            заряжаешься желанием заниматься. Занятия интересные. Получил полезные
            консультации по подбору инструмента.</p>
          </blockquote>
          <figcaption><b>Максим</b> · контрабас · сентябрь 2023</figcaption>
        </figure>
        <figure class="review">
          <blockquote>
            <p>Очень индивидуальный подход. Сергей может всё, поэтому даст вам то,
            что вам нужно, вполне мастерски. Хотите гаммы, сольфеджио, техники
            и мастерство — пожалуйста. Хотите красивую партию к понравившейся
            песне — получите (плюс немного упражнений для тренировки техники
            для этой песни… вы же хотите играть её кайфово, да же?). Очень
            профессиональный педагог, который поможет вам достичь ваших целей.</p>
          </blockquote>
          <figcaption><b>Татьяна</b> · бас-гитара · февраль 2023</figcaption>
        </figure>
        <figure class="review">
          <blockquote>
            <p>Положительное и приятное общение. Индивидуальный подход к ученику.</p>
          </blockquote>
          <figcaption><b>Денис</b> · бас-гитара · ноябрь 2022</figcaption>
        </figure>
      </div>
      <p class="note">Отзывы — с <a href="https://profi.ru/profile/SokulerSV/" target="_blank" rel="noopener noreferrer">profi.ru</a>, оценка профиля — ★5,0.</p>
    </section>

    <div class="cta">
      <a class="btn btn-primary" href="mailto:info@sokuler.ru">Записаться на занятие</a>
      <a class="btn btn-ghost" href="/o-sebe/">О себе</a>
    </div>
  </article>
</Base>

<style>
  .teach { padding: var(--sp-7) var(--pad-x) var(--sp-6); max-width: 1160px; margin-inline: auto; }
  h1 { font-size: clamp(34px, 4.4vw, 56px); max-width: 18ch; }
  .amp { color: var(--bronze); font-weight: 400; }
  .lead { font-size: var(--fs-lead); color: #453D52; font-weight: 300; line-height: 1.7; max-width: 60ch; margin: 18px 0 30px; }

  /* оглавление — липкое: при скролле прилипает к верху и всегда под рукой.
     Компактное: ссылки собраны слева, справа — воздух */
  .toc {
    position: sticky; top: 0; z-index: 40;
    display: flex; flex-wrap: wrap; gap: 10px 26px;
    width: fit-content; max-width: 100%;
    margin: 0 0 54px;
    padding: 12px 22px 12px;
    background: rgba(253, 252, 250, .92);
    backdrop-filter: blur(6px);
    border: 1px solid var(--line);
    border-radius: 0 0 10px 10px;
    scroll-margin-top: 0;
  }
  .toc a {
    font-size: 12.5px; letter-spacing: .1em; text-transform: uppercase;
    color: var(--violet-mid); text-decoration: none;
    border-bottom: 1px solid transparent; padding-bottom: 2px;
    white-space: nowrap;
  }
  .toc a:hover { color: var(--bronze); border-color: rgba(176,141,87,.5); }
  .toc a.active { color: var(--bronze); border-color: rgba(176,141,87,.6); }

  /* блоки */
  .block { margin-bottom: 58px; scroll-margin-top: 64px; }
  .block > h2 { font-size: var(--fs-h2); margin-bottom: 22px; }

  /* как проходит работа */
  .kak-grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: clamp(24px, 4vw, 56px); align-items: start; }
  .kak-text p { font-size: 15px; line-height: 1.75; color: #453D52; }
  .kak-text p + p { margin-top: 12px; }
  .kak-text b { color: var(--violet-mid); font-weight: 600; }
  .photo-card { overflow: hidden; border: 1px solid var(--line); max-width: 460px; justify-self: end; }
  .photo-card img { width: 100%; height: auto; display: block; }

  /* что вы получите */
  .get { list-style: none; columns: 2; column-gap: 48px; max-width: 900px; }
  .get li {
    font-size: 15px; line-height: 1.7; color: #453D52;
    padding-left: 20px; position: relative; margin-bottom: 10px;
    break-inside: avoid;
  }
  .get li::before { content: '—'; position: absolute; left: 0; color: var(--bronze); }

  /* направления */
  .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .card { border: 1px solid var(--line); padding: 24px 22px; background: rgba(255,255,255,.55); }
  .card h3 { font-size: 18px; margin-bottom: 12px; }
  .card p { font-size: 14px; color: #453D52; line-height: 1.7; }

  /* организация */
  .org { list-style: none; max-width: 760px; }
  .org li { font-size: 15px; line-height: 1.7; color: #453D52; padding-left: 20px; position: relative; margin-bottom: 10px; }
  .org li::before { content: '—'; position: absolute; left: 0; color: var(--bronze); }

  /* отзывы */
  .reviews { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
  .review {
    border: 1px solid var(--line); background: rgba(255,255,255,.55);
    padding: 24px 22px; display: flex; flex-direction: column; gap: 14px;
  }
  .review blockquote { margin: 0; }
  .review p { font-size: 14px; line-height: 1.75; color: #453D52; }
  .review figcaption { font-size: 12px; letter-spacing: .08em; color: #8A7F98; margin-top: auto; }
  .review figcaption b { color: var(--bronze); font-weight: 600; }
  .note { margin-top: 14px; font-size: 12px; color: #8A7F98; }
  .note a { color: #8A7F98; text-decoration: underline; }
  .note a:hover { color: var(--bronze); }

  .cta { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 46px; }

  @media (max-width: 900px) {
    .kak-grid { grid-template-columns: 1fr; }
    .photo-card { justify-self: start; }
    .get { columns: 1; }
    .grid3 { grid-template-columns: 1fr; }
    .reviews { grid-template-columns: 1fr; }
    .toc { gap: 8px 18px; }
  }
</style>

<script>
  // Scrollspy: подсветка активного раздела в липком оглавлении.
  // Наблюдатели навешиваются заново на astro:page-load (совместимо с ClientRouter).
  function initSpy() {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a'));
    if (!links.length) return;
    const targets = links
      .map((a) => document.getElementById((a.getAttribute('href') || '').slice(1)))
      .filter((el): el is HTMLElement => !!el);

    const setActive = () => {
      const line = window.innerHeight * 0.28; // раздел активен, когда заголовок выше этой линии
      let current = targets[0];
      for (const t of targets) {
        if (t.getBoundingClientRect().top <= line) current = t;
      }
      // внизу страницы активен последний раздел
      if (window.innerHeight + window.scrollY >= document.body.offsetHeight - 4) {
        current = targets[targets.length - 1];
      }
      for (const a of links) {
        a.classList.toggle('active', a.getAttribute('href') === '#' + current.id);
      }
    };

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => { setActive(); ticking = false; });
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    document.addEventListener('astro:before-swap', () => {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onScroll);
    }, { once: true });
    setActive();
  }
  document.addEventListener('astro:page-load', initSpy);
  if (document.readyState === 'complete') initSpy();
</script>
