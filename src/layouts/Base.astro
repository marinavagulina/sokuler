---
import '../styles/tokens.css';
import '../styles/base.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';

interface Props {
  title: string;
  description?: string;
  /** Тема страницы: dark (первый экран, сцена) | light (текстовые страницы) */
  theme?: 'dark' | 'light';
  /** Заголовок для соцсетей (og:title, twitter:title). По умолчанию — title */
  ogTitle?: string;
  /** Описание для соцсетей (og:description, twitter:description). По умолчанию — description */
  ogDescription?: string;
  /** Картинка для соцсетей (og:image, twitter:image) — путь от корня сайта. По умолчанию — /img/foto-hero.jpg */
  ogImage?: string;
}
const {
  title,
  description = 'Бас-гитарист и контрабасист. Обучение, концерты, записи.',
  theme = 'light',
  ogTitle = title,
  ogDescription = description,
  ogImage = '/img/foto-hero.jpg',
} = Astro.props;

// canonical — путь страницы + домен из config (ПЛЕЙСХОЛДЕР, см. SITE.url в src/config.ts).
// Хвостовой слэш приводим к единому виду — так же строит адреса sitemap.
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalURL = new URL(path, SITE.url).href;
// og:image должен быть абсолютным URL
const ogImageURL = new URL(ogImage, SITE.url).href;
// Яндекс.Метрика: номер счётчика задаётся в config.ts (SITE.metrikaId).
// Пока 0 — скрипт не подключается (локальная разработка без счётчика).
const metrikaId = Number(SITE.metrikaId ?? 0);
---
<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph / шаринг в соцсетях -->
    <!-- ПЛЕЙСХОЛДЕР og:image: foto-hero.jpg вертикальная (1500×2301); желательно горизонтальный кроп ~1200×630 -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content="Сергей Сокулер с контрабасом" />

    <!-- Twitter/X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImageURL} />

    <ClientRouter />

    <!-- Яндекс.Метрика: визиты, источники трафика, вебвизор.
         Подключается только когда SITE.metrikaId задан (не 0).
         ClientRouter делает переходы без перезагрузки — хиты шлём
         вручную на astro:page-load (и при первой загрузке тоже). -->
    {metrikaId > 0 && (
      <script is:inline define:vars={{ metrikaId }}>
        (function (m, e, t, r, i, k, a) {
          m[i] = m[i] || function () { (m[i].a = m[i].a || []).push(arguments) };
          m[i].l = 1 * new Date();
          for (var j = 0; j < e.scripts.length; j++) { if (e.scripts[j].src === r) { return; } }
          k = e.createElement(t), a = e.getElementsByTagName(t)[0], k.async = 1, k.src = r, a.parentNode.insertBefore(k, a)
        })(window, document, "script", "https://mc.yandex.ru/metrika/tag.js", "ym");

        ym(metrikaId, "init", { clickmap: true, trackLinks: true, accurateTrackBounce: true, webvisor: true });

        // хит при первой загрузке и после каждого клиентского перехода
        const sendHit = () => ym(metrikaId, "hit", window.location.href);
        sendHit();
        document.addEventListener("astro:page-load", sendHit);
      </script>
    )}
    {metrikaId > 0 && (
      <noscript><div><img src={`https://mc.yandex.ru/watch/${metrikaId}`} style="position:absolute; left:-9999px;" alt="" /></div></noscript>
    )}
  </head>
  <body data-theme={theme}>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
