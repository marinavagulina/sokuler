---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Бас-гитарист и контрабасист. Обучение, концерты, записи.' } = Astro.props;
---
<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
