---
import Base from '../layouts/Base.astro';
---
<Base title="Записи — Сергей Сокулер" theme="dark"
      description="Записи и выступления Сергея Сокулера: аудио, видео, дискография.">
  <article class="stub">
    <p class="overline">Медиа</p>
    <h1>Записи</h1>
    <p class="script hint">раздел в наполнении — собираем аудио и видео</p>
    <p class="note">
      Смотреть и слушать пока можно на
      <a href="https://youtube.com/@sokuler" target="_blank" rel="noopener noreferrer">YouTube</a>
      и <a href="https://vk.com/sokuler" target="_blank" rel="noopener noreferrer">ВКонтакте</a>.
    </p>
  </article>
</Base>

<style>
  .stub { padding: var(--sp-8) var(--pad-x); max-width: 1160px; margin-inline: auto; min-height: 40vh; }
  h1 { font-size: clamp(34px, 4.4vw, 56px); }
  .hint { color: var(--bronze-light); font-size: clamp(18px, 2vw, 24px); margin: 12px 0 24px; }
  .note { color: var(--text-dim); font-size: 14px; }
  .note a { color: var(--bronze-light); }
</style>
