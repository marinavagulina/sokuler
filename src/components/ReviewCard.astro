---
/**
 * Карточка отзыва: крупная декоративная кавычка, текст рукописным акцентом —
 * нет; текст — обычным, рукопись только в кавычке. Данные — src/data/reviews.ts.
 */
import type { Review } from '../data/reviews';

interface Props { review: Review }
const { review } = Astro.props;
---
<figure class="review">
  <blockquote>
    <p>{review.text}</p>
  </blockquote>
  <figcaption>
    <b>{review.name}</b>
    <span class="meta">{review.instrument} · {review.date}</span>
  </figcaption>
</figure>

<style>
  .review {
    position: relative;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, .6);
    padding: 26px 26px 22px;
    display: flex; flex-direction: column; gap: 16px;
  }
  .review blockquote { margin: 0; }
  .review p {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 14.5px; line-height: 1.8; color: #5C5266;
    margin: 0;
  }
  figcaption {
    margin-top: auto;
    display: flex; align-items: baseline; gap: 10px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }
  figcaption b {
    font-family: var(--font-display); font-weight: 600;
    font-size: 16px; color: var(--ink);
  }
  .meta { font-size: 12px; letter-spacing: .08em; color: #8A7F98; }
</style>
